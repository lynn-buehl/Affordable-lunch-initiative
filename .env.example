# Postgres connection string. Get this from the Neon dashboard or the
# Vercel-Neon integration, which injects it automatically in deployed
# environments. The app uses the standard Postgres wire protocol (node-postgres),
# so any Postgres works here too, e.g. a local instance for development:
# postgresql://postgres:postgres@localhost:5432/ali
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=""

# Verified sending address, e.g. "ALI <ali@yourdomain.com>"
EMAIL_FROM=""

# Canonical base URL for this environment, used to build invite/reset links.
# e.g. http://localhost:3000 in dev, https://ali.yourdomain.com in production.
APP_URL="http://localhost:3000"

# Optional: Anthropic API key (https://platform.claude.com) for receipt
# scanning. A photo of a Kassenbon is sent to Claude to read out the items and
# total; each scan costs a few cents. Leave empty to switch the feature off:
# everything else works, and expenses can still be typed in by hand.
ANTHROPIC_API_KEY=""
